[Unit]
Description=AeroBay isolated demo API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aerobay
Group=aerobay
WorkingDirectory=/srv/aerobay/current/demo-api
EnvironmentFile=/etc/aerobay/demo-api.env
ExecStart=/usr/bin/node src/app.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/aerobay/shared
MemoryMax=450M

[Install]
WantedBy=multi-user.target
